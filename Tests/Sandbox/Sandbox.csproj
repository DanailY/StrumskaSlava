<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <CodeAnalysisRuleSet>..\..\Rules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <ItemGroup>
    <AdditionalFiles Include="..\..\stylecop.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.14" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.1.118" PrivateAssets="all">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\StrumskaSlava.Common\StrumskaSlava.Common.csproj" />
    <ProjectReference Include="..\..\Data\StrumskaSlava.Data.Common\StrumskaSlava.Data.Common.csproj" />
    <ProjectReference Include="..\..\Data\StrumskaSlava.Data.Models\StrumskaSlava.Data.Models.csproj" />
    <ProjectReference Include="..\..\Data\StrumskaSlava.Data\StrumskaSlava.Data.csproj" />
    <ProjectReference Include="..\..\Services\StrumskaSlava.Services.Data\StrumskaSlava.Services.Data.csproj" />
    <ProjectReference Include="..\..\Services\StrumskaSlava.Services.Mapping\StrumskaSlava.Services.Mapping.csproj" />
    <ProjectReference Include="..\..\Services\StrumskaSlava.Services.Messaging\StrumskaSlava.Services.Messaging.csproj" />
    <ProjectReference Include="..\..\Services\StrumskaSlava.Services\StrumskaSlava.Services.csproj" />
  </ItemGroup>

</Project>
